function scheduleItem(i, div, laborCode, perPack, packWord) {
  const o = mOut(), w = 1 + i.waste / 100;
  let n;
  if (perPack > 0) { n = ceilE(i.qin * w / perPack); tr(o, 'Packages', `ceil(metres × (1 + waste) / ${packWord})`, n, 'pcs'); }
  else { n = ceilE(i.qin * w); tr(o, 'Pieces', 'ceil(quantity × (1 + waste))', n, 'pcs'); }
  if (n > 0) { priced(o, div, i.desc || i.cat, perPack > 0 ? packWord : 'pc', n, i.unitCost); o.labor.push({div, code: laborCode, qty: n}); }
  o.info.push(['To buy', `${n} ${perPack > 0 ? packWord + '(s)' : 'pc(s)'}`]);
  return o;
}
function scheduleDoc(kind, pack) {
  return {measure: `Quantities are taken from the ${kind} plan or schedule (counted, not designed).`, conversions: `Metres → packages by ${pack}.`, net: 'Quantity as counted.',
    deductions: 'None.', waste: 'Element waste %.', purchase: 'Pieces or packages rounded up.', materials: 'Priced per element (as specified).',
    labor: `${kind[0].toUpperCase() + kind.slice(1)} installation as a % of this division's materials (rate not set by default).`, equipment: 'None.', sources: 'All sizes, quantities and prices from the plans and suppliers.'};
}

// ---- BOQ with element-priced items. Legacy result is returned unchanged when there are none.
function collectPriced(st) {
  const out = [];
  for (const el of st.elements) {
    const T = TYPES[el.type]; if (!T || !T.module) continue;
    const q = Math.max(0, Math.round(+el.qty || 0)); if (!q) continue;
    for (const c of computeElement(el, st.factors).custom || []) out.push({level: el.level, div: c.div, name: `${el.mark}: ${c.name}`, unit: c.unit, qty: c.qty * q, rate: c.rate, elementId: el.id});
  }
  return out;
}
{
  const legacy = buildBOQ;
  buildBOQ = function (st) {
    const b = legacy(st), items = collectPriced(st);
    if (!items.length) return b;
    // Rebuild the row list block by block (division → level); legacy rows keep their values.
    const blocks = new Map(), key = (d, l) => d + '|' + l, divKey = Object.fromEntries(DIVS.map(([k, n]) => [n, k]));
    const estLevels = dk => b.est.filter(e => e.divs[dk]).map(e => e.level.id);
    let dk = null, li = -1;
    for (const r of b.rows) {
      if (r.kind === 'div') { dk = divKey[r.text]; li = -1; }
      else if (r.kind === 'lvl') { li++; blocks.set(key(dk, estLevels(dk)[li]), {mats: [], labs: []}); }
      else if (r.kind === 'mat') blocks.get(key(dk, estLevels(dk)[li])).mats.push(r);
      else if (r.kind === 'lab') blocks.get(key(dk, estLevels(dk)[li])).labs.push(r);
    }
    for (const it of items) {
      const k = key(it.div, it.level);
      if (!blocks.has(k)) blocks.set(k, {mats: [], labs: []});
      blocks.get(k).mats.push({kind: 'mat', code: 'PRICED', name: it.name, unit: it.unit, qty: it.qty, rate: it.rate, amt: it.qty * it.rate, custom: true, elementId: it.elementId});
    }
    const rows = [], divTotals = [];
    for (const [d, dname] of DIVS) {
      const lv = st.levels.filter(l => blocks.has(key(d, l.id)));
      if (!lv.length) continue;
      rows.push({kind: 'div', text: dname});
      let divTotal = 0;
      for (const l of lv) {
        const blk = blocks.get(key(d, l.id));
        rows.push({kind: 'lvl', text: l.name});
        let mat = 0, lab = 0;
        for (const r of blk.mats) { rows.push(r); mat += r.amt; }
        for (const r of blk.labs) {
          const x = r.pct ? {...r, rate: mat, amt: mat * r.qty / 100} : r;   // %-of-materials labor includes element-priced items
          rows.push(x); lab += x.amt;
        }
        rows.push({kind: 'sub', text: 'Subtotal – ' + l.name, mat, lab, amt: mat + lab});
        divTotal += mat + lab;
      }
      divTotals.push({div: d, name: dname, amt: divTotal});
    }
    const s = st.settings, direct = divTotals.reduce((a, x) => a + x.amt, 0);
    const ocm = direct * s.ocm / 100, profit = direct * s.profit / 100, cont = direct * s.contingency / 100;
    const sub = direct + ocm + profit + cont, vat = sub * s.vat / 100;
    return {rows, divTotals, totals: {direct, ocm, profit, cont, sub, vat, grand: sub + vat}, est: b.est};
  };
}

// ---- Worked examples (hand-calculated). Coefficient values here are TEST INPUTS only.
function runModuleSelfTests() {
  const res = [], near = (a, b, tol) => Math.abs(a - b) <= tol;
  const F = defaultFactors();
  Object.assign(F.earth, {swellPct: 25}); Object.assign(F.tile, {adhesiveKgPerSqm: 5, adhesiveBagKg: 25, groutDensity: 1600});
  Object.assign(F.paint, {primerCoverage: 10, finishCoverage: 25}); Object.assign(F.waterproof, {liquidKgPerSqmPerCoat: 1, primerLPerSqm: 0.2}); F.roof.screwsPerSqm = 6;
  const t = (name, fn) => { try { const fails = []; fn((l, g, e, tol = 1e-6) => { if (!near(g, e, tol)) fails.push(`${l}: got ${round(g, 6)}, expected ${e}`); }); res.push({name, ok: !fails.length, fails}); } catch (e) { res.push({name, ok: false, fails: [String(e)]}); } };
  const run = (type, inp) => computeElement({type, inp}, F);
  const tq = (o, label) => (o.trace.find(x => x[0] === label) || [])[2];
  const lab = (o, code) => o.labor.filter(l => l.code === code).reduce((s, l) => s + l.qty, 0);
  const cq = (o, re) => o.custom.filter(c => re.test(c.name)).reduce((s, c) => s + c.qty, 0);
  t('Excavation pit 1.5×1.5×1.5 m, 0.3 m working space, 0.5:1 slope, swell 25%', eq => {
    const o = run('excavation', {mode: 'pit', L: 1.5, W: 1.5, D: 1.5, ws: 0.3, slope: 0.5, struct: 1.076, haul: true});
    eq('A1 = 2.1²', tq(o, 'Bottom area A1'), 4.41); eq('Am = 2.85²', tq(o, 'Mid-depth area Am'), 8.1225); eq('A2 = 3.6²', tq(o, 'Top area A2'), 12.96);
    eq('V = 1.5/6 × (4.41 + 4×8.1225 + 12.96)', lab(o, 'L_EXC'), 12.465); eq('backfill = 12.465 − 1.076', lab(o, 'L_BF'), 11.389); eq('loose disposal = 1.076 × 1.25', lab(o, 'L_HAUL'), 1.345);
  });
  t('Trench 10 m × 0.6 m × 0.8 m, vertical sides', eq => eq('V', lab(run('excavation', {mode: 'trench', L: 10, W: 0.6, D: 0.8, haul: false}), 'L_EXC'), 4.8));
  t('Gable roof 10 × 8 m, 0.6 m overhang, 20°, 0.76 m cover width', eq => {
    const o = run('roofing', {form: 'gable', L: 10, W: 8, oh: 0.6, pitch: 20, cw: 0.76, sheetCost: 1});
    eq('slope factor 1/cos 20°', tq(o, 'Slope factor'), 1.0641777725, 1e-9); eq('slope length 4.6 × k', tq(o, 'Slope length'), 4.6 * 1.0641777725, 1e-8);
    eq('roof area 2 × 11.2 × 4.8952', lab(o, 'L_ROOF'), 2 * 11.2 * 4.6 / Math.cos(Math.PI / 9), 1e-9); eq('rows ceil(11.2/0.76)', tq(o, 'Sheet rows per slope'), 15);
    eq('sheet metres 2 × 15 × slope length', cq(o, /^Roofing sheet/), round(30 * 4.6 / Math.cos(Math.PI / 9), 2), 1e-9);
    eq('screws 6/m²', o.lines.find(l => l.code === 'RSCR').qty, 6 * 2 * 11.2 * 4.6 / Math.cos(Math.PI / 9), 1e-6);
  });
  t('Floor tiles 4 × 5 m, 600×600×10 mm, 3 mm joint, no waste', eq => {
