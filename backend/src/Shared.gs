    if (pol.priceValidityDays !== undefined) { if (isNum(pol.priceValidityDays) && Number(pol.priceValidityDays) >= 0) P.priceValidityDays = Number(pol.priceValidityDays); else bad('audit.policy.priceValidityDays', pol.priceValidityDays, P.priceValidityDays); }
    if (pol.unverifiedCoefficients !== undefined) { if (pol.unverifiedCoefficients === 'critical' || pol.unverifiedCoefficients === 'major') P.unverifiedCoefficients = pol.unverifiedCoefficients; else bad('audit.policy.unverifiedCoefficients', pol.unverifiedCoefficients, P.unverifiedCoefficients); }
