function chbCalc(i, F, div) {
  const o = newOut(), op = parseOpenings(i.open), net = Math.max(0, i.L * i.H - op.area);
  const mf = F.chb.mortar[i.size] || F.chb.mortar['4'];
  o.lines.push({div, code: 'CHB' + i.size, qty: net * F.chb.perSqm * (1 + (+i.waste || 0) / 100)},
    {div, code: 'CEM', qty: net * mf[i.mcls]}, {div, code: 'SAND', qty: net * mf.sand});
  const plA = net * (+i.faces || 0);
  if (plA > 0) {
