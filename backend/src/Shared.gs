    eq('module 0.603²', tq(o, 'Tile module'), 0.363609); eq('tiles to buy ceil(20 / 0.363609)', cq(o, /^Tiles/), 56);
    eq('grout 0.16 kg/m² × 20', o.lines.find(l => l.code === 'TGRT').qty, 3.2, 1e-9); eq('adhesive 20 × 5 / 25 bags', o.lines.find(l => l.code === 'TADH').qty, 4, 1e-9);
  });
  t('Wall paint 18 m × 3 m less one 0.9×2.1 door, 2 coats at 25 m²/L, 4 L containers', eq => {
    const o = run('painting', {surf: 'wall', L: 18, H: 3, open: '0.9x2.1x1', fc: 2, cont: 4, finishCost: 1});
    eq('net area 54 − 1.89', lab(o, 'L_PAINT'), 52.11); eq('litres 52.11 × 2 / 25', tq(o, 'Finish paint'), 4.1688); eq('containers ceil(4.1688/4)', cq(o, /^Finish paint/), 2);
