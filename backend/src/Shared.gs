  const c = (Number(i.cover) || 0) / 1000;
  const inner = {column: [['b', i.b], ['h', i.h]], beam: [['b', i.b], ['h', i.h]], footing: [['L', i.L], ['W', i.W]], wallfooting: [['B', i.B], ['L', i.L]], slab: [['Lx', i.Lx], ['Ly', i.Ly]], rcwall: [['L', i.L], ['H', i.H]], stairs: [['W', i.W]]}[el.type] || [];
  for (const [k, d] of inner) if (d > 0 && d - 2 * c <= 0) R('R-RB-001', k, `Cover ${i.cover} mm on each side is not less than half of ${k} = ${d} m, so the bars have no length (ties would be cut to their hooks only).`, {dimension: k, value: d, cover: i.cover, inner: Math.round((d - 2 * c) * 1000) / 1000}, 'Check the cover and the member size.');
  const spans = {
    footing: [['sL', i.W - 2 * c], ['sW', i.L - 2 * c]], wallfooting: [['sT', i.L - 2 * c]], slab: [['sBx', i.Ly - 2 * c], ['sBy', i.Lx - 2 * c]],
    rcwall: [['sV', i.L - 2 * c], ['sH', i.H - 2 * c]], stairs: [['sM', i.W - 2 * c], ['sD', Math.hypot(i.run, i.rise)]], column: [['sT', i.H]], beam: [['sS', i.L]],
  }[el.type] || [];
  for (const [k, w] of spans) if (i[k] > 0 && w > 0 && i[k] / 1000 >= w) R('R-RB-002', k, `Spacing ${i[k]} mm is not smaller than the available width ${Math.round(w * 1000)} mm, so only one bar is counted.`, {field: k, spacing: i[k], width_mm: Math.round(w * 1000)}, 'Check the spacing unit and value.');
  if ((el.type === 'column' || el.type === 'beam') && i.Lo > 0) {
    const len = el.type === 'column' ? i.H : i.L;
    if (2 * i.Lo >= len) R('R-RB-004', 'Lo', `Confined zones (2 × ${i.Lo} m) cover the whole length ${len} m, so the uniform spacing is used instead.`, {Lo: i.Lo, length: len}, 'Reduce the confined zone length or set it to 0.');
  }
  if (['chbwall', 'chbpart', 'drywall'].includes(el.type)) {
    const op = parseOpenings(i.open);
    if (op.errors.length) R('R-DIM-006', 'open', `Openings "${op.errors.join(', ')}" could not be read and are not deducted.`, {unreadable: op.errors}, 'Write openings as W x H x count, e.g. 0.9x2.1x2.');
    if (i.L > 0 && i.H > 0 && op.area >= i.L * i.H) R('R-DIM-005', 'open', `Openings (${Math.round(op.area * 100) / 100} m²) are not smaller than the wall (${Math.round(i.L * i.H * 100) / 100} m²), so the net area is 0.`, {openings_m2: Math.round(op.area * 1e4) / 1e4, wall_m2: Math.round(i.L * i.H * 1e4) / 1e4}, 'Check the opening sizes and the wall length/height.');
  }
  if (T.checks) for (const c of T.checks(i)) R(c.rule, c.path, c.description, c.evidence, c.suggestion);
  let r = null;
  try { r = computeElement(el, F); } catch (e) { R('R-QTY-001', '', 'The calculation failed: ' + e.message, {error: e.message}, 'Check the inputs.'); }
  if (r && r.missing && r.missing.length) R('R-COEF-003', 'missing', `Coefficient(s) not set: ${r.missing.join(', ')}. The quantities that need them are left out of the BOQ.`, {coefficients: r.missing}, 'Enter each value on the Factors tab from its cited source, record the table/page and tick Verified.');
  const nothing = r && !r.lines.length && !r.bars.length && !(r.custom && r.custom.length) && !(T.laborOnly && r.labor.some(l => l.qty > 0));
  if (nothing && !out.some(x => RULES[x.rule][0] === 'critical')) R('R-QTY-001', '', 'These inputs produce no material quantities.', {lines: 0, bars: 0}, 'Check the dimensions, spacing and cover.');
  return out;
}

// ---- Reconciliation of a BOQ (pure; used by runAudit and tested with tampered input)
function reconcileChecks(boq, s) {
  // money tolerance: half a centavo (relative 1e-9 only to absorb floating-point noise on very large totals)
  const T = boq.totals, near = (a, b) => Math.abs(a - b) <= Math.max(0.005, 1e-9 * Math.abs(b)), r2 = x => Math.round(x * 100) / 100;
  const failures = [], nonFinite = [];
  for (const [k, v] of Object.entries(T)) if (!Number.isFinite(v)) nonFinite.push(k + ' total');
  if (boq.rows.some(r => (r.kind === 'mat' || r.kind === 'lab') && !Number.isFinite(r.amt))) nonFinite.push('BOQ line amount');
  let sub = 0, lineSum = 0, divSum = 0, printedLines = 0, printedSubs = 0, printedDirect = 0;
  for (const r of boq.rows) {
    if (r.kind === 'mat' || r.kind === 'lab') {
      const exp = r.pct ? r.rate * r.qty / 100 : r.qty * r.rate;
      if (!near(r.amt, exp)) failures.push(`${r.name}: amount ${r.amt} ≠ qty × rate ${exp}`);
      sub += r.amt; lineSum += r.amt; printedLines += r2(r.amt);
    } else if (r.kind === 'sub') {
      if (!near(r.amt, sub)) failures.push(`${r.text}: subtotal ${r.amt} ≠ sum of lines ${sub}`);
      if (Math.abs(r2(printedLines) - r2(r.amt)) >= 0.01) printedSubs++;
      sub = 0; printedLines = 0;
    }
  }
  for (const d of boq.divTotals) { divSum += d.amt; printedDirect += r2(d.amt); }
  if (!near(divSum, T.direct)) failures.push(`division totals ${divSum} ≠ direct cost ${T.direct}`);
  if (!near(lineSum, T.direct)) failures.push(`line amounts ${lineSum} ≠ direct cost ${T.direct}`);
  if (!near(T.ocm, T.direct * s.ocm / 100) || !near(T.profit, T.direct * s.profit / 100) || !near(T.cont, T.direct * s.contingency / 100)) failures.push('markups ≠ direct cost × rate');
  if (!near(T.sub, T.direct + T.ocm + T.profit + T.cont)) failures.push('subtotal ≠ direct cost + markups');
  if (!near(T.vat, T.sub * s.vat / 100) || !near(T.grand, T.sub + T.vat)) failures.push('VAT or grand total inconsistent');
  return {failures: nonFinite.length ? [] : failures, nonFinite, printedSubs, printedDirectDiff: Math.round(Math.abs(r2(printedDirect) - r2(T.direct)) * 100)};
}

// ---- Project-level audit
function runAudit(st, {today} = {}) {
  const F = st.factors, P = st.policy || (st.audit && st.audit.policy) || defaultAuditState().policy, A = st.audit || defaultAuditState();
  const projectId = (st.meta && st.meta.projectId) || '', revision = (st.meta && st.meta.revision) || 0;
  const found = [], markOf = id => (st.elements.find(e => e.id === id) || {}).mark;
  const F_ = (rule, key, description, evidence, suggestion, elementIds = [], paths = []) => {
    const [severity, title] = RULES[rule];
    found.push({rule, key, severity, title, description, evidence, suggestion, elementIds, paths});
  };
  const levelName = id => (st.levels.find(l => l.id === id) || {}).name || '?';
  // Element rules
  for (const el of st.elements) for (const c of elementChecks(el, F))
    F_(c.rule, el.id + '|' + c.path, `${el.mark} (${TYPES[el.type].name}, ${levelName(el.level)}): ${c.description}`, c.evidence, c.suggestion, [el.id], c.path ? [`elements.${el.id}.inp.${c.path}`] : []);

  const boq = buildBOQ(st), est = boq.est;
  // Rebar purchasable
  for (const {level, divs} of est) for (const [dk, d] of Object.entries(divs)) for (const dia of d.bars.keys()) if (!d.rebar.some(o => o.dia === dia)) {
    const ids = st.elements.filter(e => e.level === level.id && computeElement(e, F).bars.some(b => b.dia === dia && b.div === dk)).map(e => e.id);
    F_('R-RB-003', `${level.id}|${dk}|${dia}`, `${dia} mm bars on ${level.name} (${DIV_NAME[dk]}) cannot be bought: no commercial length is longer than the ${Math.round(lapLen(dia, F) * 100) / 100} m lap, so they are missing from the BOQ.`,
      {dia, lap_m: Math.round(lapLen(dia, F) * 1000) / 1000, commercial: st.settings.stock === 'auto' ? F.rebar.commercial : [Number(st.settings.stock)]}, 'Use a longer commercial length or check the lap factor.', ids);
  }
  // Prices
  const matRows = boq.rows.filter(r => r.kind === 'mat' && !r.custom), labRows = boq.rows.filter(r => r.kind === 'lab' && !r.eq);
  for (const r of boq.rows.filter(r => r.custom && !(Number(r.rate) > 0))) F_('R-PRICE-001', 'priced|' + r.elementId + '|' + r.name, `${r.name} has no unit cost.`, {item: r.name, unit: r.unit, qty: r.qty, rate: r.rate}, 'Enter the unit cost in the element (from the supplier quotation).', [r.elementId]);
  const usedMat = [...new Set(matRows.map(r => r.code))], usedLab = [...new Set(labRows.map(r => r.code))];
  for (const c of usedMat) { const p = st.prices[c]; if (!(Number(p.price) > 0)) F_('R-PRICE-001', c, `${p.name} is in the BOQ with a price of ${p.price}.`, {code: c, price: p.price}, 'Enter the supplier price.', [], ['prices.' + c]); }
  const sampleM = usedMat.filter(c => st.prices[c].source === 'sample');
  if (sampleM.length) F_('R-PRICE-002', 'materials', `${sampleM.length} of ${usedMat.length} priced materials use sample prices. Sample prices are placeholders, not market data.`, {codes: sampleM}, 'Enter your supplier prices on the Prices tab.', [], sampleM.map(c => 'prices.' + c));
  if (today) {
    const t0 = Date.parse(today), days = Number(P.priceValidityDays) || 0, old = [], undated = [];
    for (const [c, o, kind] of [...usedMat.map(c => [c, st.prices[c], 'prices']), ...usedLab.map(c => [c, st.labor[c], 'labor'])]) {
      if (o.source !== 'user') continue;
      if (!o.updatedAt) { undated.push(`${kind}.${c}`); continue; }
      const age = Math.floor((t0 - Date.parse(o.updatedAt)) / 86400000);
      if (days > 0 && age > days) old.push({path: `${kind}.${c}`, updatedAt: o.updatedAt, ageDays: age});
    }
    if (old.length) F_('R-PRICE-003', 'expired', `${old.length} price(s) are older than ${days} days.`, {validityDays: days, prices: old}, 'Confirm or update these prices.', [], old.map(o => o.path));
    if (undated.length) F_('R-PRICE-006', 'undated', `${undated.length} of your price(s) have no recorded date, so their age cannot be checked.`, {paths: undated}, 'Re-enter the price to record today\'s date.', [], undated);
  }
  for (const c of usedLab) { const l = st.labor[c]; if ((l.mode === 'unit' || l.mode === 'pct') && !(Number(l.rate) > 0)) F_('R-PRICE-004', c, `${l.name} has a rate of ${l.rate}${l.mode === 'pct' ? '%' : ''}.`, {code: c, rate: l.rate}, 'Enter the labor rate, or confirm labor is excluded.', [], ['labor.' + c]); }
  const sampleL = usedLab.filter(c => st.labor[c].source === 'sample' && (st.labor[c].mode === 'unit' || st.labor[c].mode === 'pct'));
  // Labor methods (Phase 4)
  const LS = laborSetupOf(st), eqOf = id => (LS.equipment || []).find(e => e.id === id);
  for (const c of usedLab) {
    const l = st.labor[c], ids = [];
    if (l.mode === 'productivity') {
      const cc = crewDayCost(LS, l.crew);
      if (!cc.crew) F_('R-LAB-001', c + '|crew', `${l.name}: the productivity method has no crew selected, so this labor is costed at 0.`, {item: c}, 'Select a crew on the Labor & equipment tab.', ids, ['labor.' + c]);
      else if (cc.cost === null) F_('R-LAB-001', c + '|wage', `${l.name}: crew "${cc.crew.name}" cannot be costed (${cc.missing.join(', ')}: wage or members not set), so this labor is costed at 0.`, {item: c, crew: cc.crew.name, missing: cc.missing}, 'Enter the daily wage of each trade in the crew.', ids, ['laborSetup.crews.' + cc.crew.id]);
      if (!(Number(l.output) > 0)) F_('R-LAB-001', c + '|output', `${l.name}: crew output per day is not set.`, {item: c, output: l.output}, 'Enter the output per crew-day from your records or reference.', ids, ['labor.' + c + '.output']);
    } else if (l.mode === 'pakyaw') {
      if (!(Number(l.lump) > 0)) F_('R-LAB-002', c + '|lump', `${l.name}: the pakyaw lump sum is not set, so this labor is costed at 0.`, {item: c, lump: l.lump}, 'Enter the agreed pakyaw amount for the whole scope.', ids, ['labor.' + c + '.lump']);
    } else if (l.mode === 'rental') {
      const eq = eqOf(l.equip);
      if (!eq) F_('R-LAB-002', c + '|equip', `${l.name}: no equipment is selected for the rental method.`, {item: c}, 'Select the equipment on the Labor & equipment tab.', ids, ['labor.' + c]);
      else if (!(Number(eq.rate) > 0)) F_('R-LAB-002', c + '|rate', `${eq.name}: the rental rate is not set.`, {equipment: eq.name}, 'Enter the rental rate.', ids, ['laborSetup.equipment.' + eq.id]);
      else if (!['hr', 'day'].includes(l.unit) && !(Number(l.eqOutput) > 0)) F_('R-LAB-002', c + '|eqout', `${l.name}: output per ${eq.basis} of ${eq.name} is not set.`, {item: c}, 'Enter how many units of work the equipment does per hour/day.', ids, ['labor.' + c + '.eqOutput']);
    }
    const seen = new Set();
    for (const [n, a] of (l.attach || []).entries()) {
      const eq = eqOf(a.equip);
      if (!eq || !(Number(eq.rate) > 0) || !(Number(a.output) > 0)) F_('R-LAB-002', c + '|att|' + n, `${l.name}: attached equipment ${eq ? eq.name : '(missing)'} has no ${!eq ? 'definition' : !(Number(eq.rate) > 0) ? 'rental rate' : 'output per ' + eq.basis}.`, {item: c, equipment: eq ? eq.name : a.equip}, 'Complete the equipment rate and output.', ids, ['labor.' + c + '.attach']);
      if (seen.has(a.equip)) F_('R-LAB-003', c + '|dup|' + a.equip, `${l.name}: ${eq ? eq.name : a.equip} is attached more than once.`, {item: c}, 'Remove the duplicate attachment.', ids, ['labor.' + c + '.attach']);
      seen.add(a.equip);
    }
  }
  { // equipment line and attached equipment in the same division and level
    let dv = null, lv = null, hasLine = false, hasAtt = false;
    const flush = () => { if (hasLine && hasAtt) F_('R-LAB-003', dv + '|' + lv, `${lv} (${dv}): an equipment line and equipment attached to a labor item are both costed. Check that the same machine is not counted twice.`, {division: dv, level: lv}, 'Keep either the equipment line or the attachment.'); };
    for (const r of boq.rows) {
      if (r.kind === 'div' || r.kind === 'lvl') { flush(); hasLine = hasAtt = false; if (r.kind === 'div') dv = r.text; else lv = r.text; }
      else if (r.kind === 'lab' && r.eq && r.code.startsWith('EQ:')) hasAtt = true;
      else if (r.kind === 'lab' && !r.eq && EQUIPMENT_CODES.has(r.code)) hasLine = true;
    }
    flush();
  }
  if (sampleL.length) F_('R-PRICE-005', 'labor', `${sampleL.length} labor rate(s) are sample values.`, {codes: sampleL}, 'Enter your own labor rates on the Prices tab.', [], sampleL.map(c => 'labor.' + c));
  // Coefficients
  const FM = st.factorMeta || {}, use = new Map();
  for (const el of st.elements) if (Number(el.qty) > 0) for (const p of factorsUsed(el, F)) { if (!use.has(p)) use.set(p, []); use.get(p).push(el.id); }
  const interp = [...use.keys()].filter(p => FM[p] && /interpolated/i.test(FM[p].source || '') && !FM[p].verified);
  const valueOf = p => p.split('.').reduce((a, k) => (a == null ? a : a[k]), F);
  const unver = [...use.keys()].filter(p => FM[p] && !FM[p].verified && !interp.includes(p) && valueOf(p) !== null && valueOf(p) !== undefined).sort();   // unset ones are R-COEF-003
  if (interp.length) F_('R-COEF-002', 'interp', `${interp.join(', ')} ${interp.length > 1 ? 'are' : 'is'} interpolated with no cited source and ${interp.length > 1 ? 'are' : 'is'} used by ${new Set(interp.flatMap(p => use.get(p))).size} element(s).`,
    {coefficients: interp.map(p => ({path: p, source: FM[p].source, note: FM[p].note}))}, 'Replace the value with one from a cited table and record the reference, or use a different CHB size.', [...new Set(interp.flatMap(p => use.get(p)))], interp.map(p => 'factors.' + p));
  if (unver.length) {
    found.push({rule: 'R-COEF-001', key: 'unverified', severity: P.unverifiedCoefficients === 'major' ? 'major' : 'critical', title: RULES['R-COEF-001'][1],
      description: `${unver.length} coefficient(s) used by this estimate are not verified against their source.`,
      evidence: {coefficients: unver.map(p => ({path: p, source: FM[p].source, ref: FM[p].ref, elements: use.get(p).length}))},
      suggestion: 'On the Factors tab, check each value against its source, record the table/page and tick Verified.', elementIds: [], paths: unver.map(p => 'factors.' + p)});
  }
  // Duplicates
  const sig = new Map(), marks = new Map();
  for (const e of st.elements) {
    const k = canon({type: e.type, level: e.level, inp: normInputs(e.type, e.inp)});
    if (!sig.has(k)) sig.set(k, []); sig.get(k).push(e.id);
    const m = String(e.mark).trim().toLowerCase(); if (!marks.has(m)) marks.set(m, []); marks.get(m).push(e.id);
  }
  for (const ids of sig.values()) if (ids.length > 1) F_('R-DUP-001', ids.join('|'), `${ids.map(markOf).join(', ')} have the same type, level and inputs.`, {elements: ids.map(markOf)}, 'If they are the same element, delete one; if they are separate, increase the quantity of one instead.', ids);
  for (const [m, ids] of marks) if (ids.length > 1) F_('R-DUP-002', 'mark|' + m, `Mark "${markOf(ids[0])}" is used by ${ids.length} elements.`, {mark: markOf(ids[0]), elements: ids.length}, 'Give each element its drawing mark.', ids);
  // Overlaps (upper bounds; depends on how depths/heights were measured)
  for (const lv of st.levels) {
    const at = t => st.elements.filter(e => e.level === lv.id && e.type === t && Number(e.qty) > 0);
    const beams = at('beam'), slabs = at('slab'), cols = at('column'), N = e => normInputs(e.type, e.inp), qn = e => Math.round(Number(e.qty));
    if (beams.length && slabs.length) {
      const t = Math.max(...slabs.map(e => N(e).t)), bound = beams.reduce((s, e) => s + N(e).b * N(e).L * Math.min(t, N(e).h) * qn(e), 0);
      F_('R-OVL-001', lv.id, `${lv.name}: beams and slabs are both costed at full depth. If the beam depth includes the slab, up to ${Math.round(bound * 1000) / 1000} m³ of concrete is counted twice.`,
        {level: lv.name, maxSlabThickness_m: t, beams: beams.map(e => e.mark), overlapUpperBound_m3: Math.round(bound * 1e6) / 1e6}, 'If beam depths include the slab, enter the depth below the slab, or accept this as a known allowance.', beams.concat(slabs).map(e => e.id));
    }
    if (beams.length && cols.length) {
      const hb = Math.max(...beams.map(e => N(e).h)), bound = cols.reduce((s, e) => s + N(e).b * N(e).h * hb * qn(e), 0);
      F_('R-OVL-002', lv.id, `${lv.name}: if column heights run through the beams, up to ${Math.round(bound * 1000) / 1000} m³ of beam–column joint concrete is counted twice.`,
        {level: lv.name, maxBeamDepth_m: hb, columns: cols.map(e => e.mark), overlapUpperBound_m3: Math.round(bound * 1e6) / 1e6}, 'Use clear heights for columns, or accept this as a known allowance.', beams.concat(cols).map(e => e.id));
    }
  }
  // Reconciliation
  const T = boq.totals, s = st.settings, rc = reconcileChecks(boq, s);
  for (const k of rc.nonFinite) F_('R-REC-003', 'total|' + k, `The ${k} is not a finite number.`, {item: k}, 'Check prices and rates for empty or invalid values.');
  if (rc.failures.length) F_('R-REC-001', 'reconcile', `${rc.failures.length} reconciliation check(s) failed.`, {failures: rc.failures.slice(0, 20)}, 'This indicates a calculation defect. Do not use this estimate; report it.');
  if (rc.printedSubs || rc.printedDirectDiff) F_('R-REC-002', 'rounding', `${rc.printedSubs} printed subtotal(s) differ from the sum of their printed lines by at least one centavo because amounts are rounded only for display.`, {subtotals: rc.printedSubs, directDifferenceCentavos: rc.printedDirectDiff}, 'Expected with fractional quantities; state "amounts rounded for display" on the BOQ, or round prices to centavos.');
  // Markups & VAT
  for (const k of ['ocm', 'profit', 'contingency', 'vat']) {
    const v = s[k];
    if (!Number.isFinite(Number(v)) || v < 0 || v > 100) F_('R-MKP-001', k, `${k.toUpperCase()} is ${v}%.`, {setting: k, value: v}, 'Enter a percentage between 0 and 100.', [], ['settings.' + k]);
    else if (k === 'vat' ? !(v === 12 || v === 0) : v > AUDIT_LIMITS.markupMax) F_('R-MKP-002', k, k === 'vat' ? `VAT is ${v}%; the Philippine VAT rate is 12% (0% only for exempt or zero-rated work).` : `${k.toUpperCase()} is ${v}%, above ${AUDIT_LIMITS.markupMax}%.`, {setting: k, value: v}, 'Confirm the percentage.', [], ['settings.' + k]);
  }
  // Takeoff completeness
  const TK = st.takeoff || {};
  for (const lv of st.levels) {
    const els = st.elements.filter(e => e.level === lv.id), reg = TK[lv.id] || {};
    if (!els.length) F_('R-TO-001', lv.id, `${lv.name} has no elements.`, {level: lv.name}, 'Take off this level, or delete it if it is not in the drawings.');
    const pending = [];
    for (const [k, name, types] of TAKEOFF_SCOPES) {
      const n = els.filter(e => types.includes(e.type)).length, stt = reg[k] || 'pending';
      if (stt === 'complete' && !n) F_('R-TO-003', lv.id + '|' + k, `${lv.name}: ${name} is marked complete but has no elements.`, {level: lv.name, scope: name}, 'Add the elements, or mark the scope Not applicable.');
      if (stt === 'na' && n) F_('R-TO-004', lv.id + '|' + k, `${lv.name}: ${name} is marked not applicable but has ${n} element(s).`, {level: lv.name, scope: name, elements: n}, 'Change the status, or remove the elements.');
      if (stt === 'pending' || stt === 'progress') pending.push(`${name} (${stt === 'pending' ? 'not started' : 'in progress'})`);
    }
    if (pending.length) F_('R-TO-002', lv.id, `${lv.name}: ${pending.length} of ${TAKEOFF_SCOPES.length} scopes are not marked Complete or Not applicable.`, {level: lv.name, scopes: pending}, 'Mark each scope in the takeoff register as you finish it.');
  }
  for (const rv of st.revisions || []) if (typeof revisionIntact === 'function' && !revisionIntact(rv)) F_('R-REV-001', 'rev|' + rv.no, `Revision ${rv.no} failed its integrity check: its stored snapshot does not match the hash recorded when it was created.`, {revision: rv.no, storedHash: rv.snapshotHash}, 'Do not rely on this revision. Restore the project file from a trusted copy.');
  if (st.quarantine && st.quarantine.elements && st.quarantine.elements.length) F_('R-QUA-001', 'q', `${st.quarantine.elements.length} element(s) from a loaded file could not be used and are not costed.`, {elements: st.quarantine.elements.map(e => (e && e.mark) || '?')}, 'Re-enter them with a supported element type, then remove them from quarantine.');
  // Staleness
  const H = inputHashes(st), changed = old => Object.keys(H).filter(k => k !== 'all' && old && old[k] !== H[k]);
