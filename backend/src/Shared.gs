// Fill missing inputs with defaults, coerce numbers
function normInputs(type, inp) {
  const out = {};
  for (const f of TYPES[type].fields) {
    if (!f.k) continue;
    let v = inp && inp[f.k] !== undefined ? inp[f.k] : f.def;
    if (f.t === 'num') v = Number(v) || 0;
    else if (f.t === 'chk') v = !!v;
    else if (f.t === 'sel' && typeof f.def === 'number') v = Number(v);
    out[f.k] = v;
  }
  return out;
}
function computeElement(el, F) {
  const o = TYPES[el.type].calc(normInputs(el.type, el.inp), F);
  const kg = o.bars.reduce((s, b) => s + b.len * b.n * kgpm(b.dia), 0);
  if (o.bars.length) o.info.unshift(['Rebar (net, 1 element)', fmt(kg) + ' kg']);
  o.kg = kg;
  return o;
}

// Build the whole estimate: per level, per division quantities and costs
function buildEstimate(st) {
  const F = st.factors, set = st.settings, levels = [];
  for (const lv of st.levels) {
    const els = st.elements.filter(e => e.level === lv.id);
    const divs = {};
    const D = k => divs[k] || (divs[k] = {lines: new Map(), labor: new Map(), bars: new Map(), x: 0, rebar: []});
    for (const el of els) {
      const q = Math.max(0, Math.round(+el.qty || 0)), r = computeElement(el, F);
      for (const b of r.bars) {
        const d = D(b.div), arr = d.bars.get(b.dia) || [];
        arr.push({len: b.len, n: b.n * q}); d.bars.set(b.dia, arr);
      }
      if (r.bars.length && r.x) D(r.bars[0].div).x += r.x * q;
      for (const l of r.lines) { const d = D(l.div); d.lines.set(l.code, (d.lines.get(l.code) || 0) + l.qty * q); }
      for (const l of r.labor) { const d = D(l.div); d.labor.set(l.code, (d.labor.get(l.code) || 0) + l.qty * q); }
    }
    for (const [k, d] of Object.entries(divs)) {
      let netKg = 0;
      for (const dia of [...d.bars.keys()].sort((a, b) => a - b)) {
        const opt = optimizeDia(d.bars.get(dia), dia, F, set.stock);
        if (!opt) continue;
        d.rebar.push(opt); netKg += opt.netKg;
        d.lines.set('RB' + dia, (d.lines.get('RB' + dia) || 0) + opt.kg);
      }
      if (d.x > 0) d.lines.set('TW', (d.lines.get('TW') || 0) + d.x * F.rebar.tieWirePerX / F.rebar.tieWireMPerKg);
      if (k === 'REBAR' && netKg > 0) d.labor.set('L_RB', (d.labor.get('L_RB') || 0) + netKg);
    }
    levels.push({level: lv, divs});
  }
  return levels;
}
function qtyRound(qty, unit) { return CEIL_UNITS.has(unit) ? ceilE(qty) : round(qty, 2); }

// Costed BOQ rows
function buildBOQ(st) {
  const est = buildEstimate(st), P = st.prices, Lb = st.labor, rows = [], divTotals = [];
  for (const [dk, dname] of DIVS) {
    const parts = est.filter(e => e.divs[dk]);
    if (!parts.length) continue;
    rows.push({kind: 'div', text: dname});
    let divTotal = 0;
    for (const {level, divs} of parts) {
      const d = divs[dk];
      rows.push({kind: 'lvl', text: level.name});
      let mat = 0, lab = 0;
      for (const [code] of MATERIALS) {
        if (!d.lines.has(code)) continue;
        const m = P[code], qty = qtyRound(d.lines.get(code), m.unit), amt = qty * (+m.price || 0);
        let name = m.name;
        if (code.startsWith('RB')) { const o = d.rebar.find(r => 'RB' + r.dia === code); if (o) name += ` (${o.bars} pcs × ${o.stock} m)`; }
        rows.push({kind: 'mat', code, name, unit: m.unit, qty, rate: +m.price || 0, amt}); mat += amt;
      }
      for (const [code] of LABOR) {
        if (!d.labor.has(code)) continue;
        const l = Lb[code];
        if (l.mode === 'pct') {
          const amt = mat * (+l.rate || 0) / 100;
          rows.push({kind: 'lab', code, name: l.name, unit: '%', qty: +l.rate || 0, rate: mat, amt, pct: true}); lab += amt;
        } else {
          const qty = round(d.labor.get(code), 2), amt = qty * (+l.rate || 0);
          rows.push({kind: 'lab', code, name: l.name, unit: l.unit, qty, rate: +l.rate || 0, amt}); lab += amt;
        }
      }
      rows.push({kind: 'sub', text: 'Subtotal – ' + level.name, mat, lab, amt: mat + lab});
      divTotal += mat + lab;
    }
    divTotals.push({div: dk, name: dname, amt: divTotal});
  }
  const s = st.settings, direct = divTotals.reduce((a, b) => a + b.amt, 0);
  const ocm = direct * s.ocm / 100, profit = direct * s.profit / 100, cont = direct * s.contingency / 100;
  const sub = direct + ocm + profit + cont, vat = sub * s.vat / 100;
  return {rows, divTotals, totals: {direct, ocm, profit, cont, sub, vat, grand: sub + vat}, est};
}

