// ===== <script id="labor"> =====

'use strict';
// Phase 4: labor and equipment costing. Each labor item has exactly ONE active
// method, so switching methods can never count the same work twice:
//   pct          – % of the division's materials (legacy)
//   unit         – ₱ per unit of quantity (legacy)
//   productivity – quantity ÷ crew output per day × crew day cost
//   pakyaw       – one lump sum for the whole project, split across levels by quantity share
//   rental       – equipment items only: billed hours/days × rental rate (minimum charge applies)
// Optional equipment can be attached to a (non-equipment) labor item; mobilization
// is charged once per equipment for the project. When every item uses pct/unit and
// nothing is attached, buildBOQ returns the previous result unchanged.
const LABOR_VERSION = '1.0.0';
const LABOR_METHODS = [['pct', '% of materials (legacy)'], ['unit', 'Unit rate (₱ per unit)'], ['productivity', 'Productivity (crew × days)'], ['pakyaw', 'Pakyaw (lump sum for the scope)']];
const EQUIP_METHODS = [['unit', 'Unit rate (₱ per unit)'], ['rental', 'Rental (rate × hours or days)']];
const DEFAULT_TRADES = [['T_FORE', 'Foreman'], ['T_MASON', 'Mason'], ['T_CARP', 'Carpenter'], ['T_STEEL', 'Steelman'], ['T_WELD', 'Welder'],
  ['T_ELEC', 'Electrician'], ['T_PLUMB', 'Plumber'], ['T_PAINT', 'Painter'], ['T_HELP', 'Laborer / helper'], ['T_OPER', 'Equipment operator']];
const SPECIAL_METHODS = new Set(['productivity', 'pakyaw', 'rental']);

function defaultLaborSetup() {
