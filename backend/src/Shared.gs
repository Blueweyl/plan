// ===== <script id="modules"> =====

'use strict';
// Phase 3 calculators. They register into the engine's tables (TYPES, DIVS,
// MATERIALS, LABOR, defaultFactors, buildBOQ) without changing any existing
// formula: legacy element types, catalog entries and factors are untouched,
// and buildBOQ returns the legacy result unchanged when no module item exists.
// Coefficients that would have to come from a book or a product data sheet
// start as null ("not set"); a calculation that needs one omits that material
// and reports it (auditor rule R-COEF-003) instead of guessing.
const MODULES_VERSION = '1.0.0';
const MOD_DIVS = [['EARTH', 'Earthworks'], ['ROOF', 'Roofing Works'], ['TILE', 'Tile Works'], ['WP', 'Waterproofing Works'], ['PAINT', 'Painting Works'],
  ['DW', 'Doors & Windows'], ['STEEL', 'Structural Steel Works'], ['PLUMB', 'Plumbing Works'], ['ELEC', 'Electrical Works']];
for (const d of MOD_DIVS) { DIVS.push(d); DIV_NAME[d[0]] = d[1]; }
// New catalog entries have no price (0): they are reported as unpriced until set.
MATERIALS.push(['TADH', 'Tile adhesive', 'bag', 0], ['TGRT', 'Tile grout', 'kg', 0], ['RSCR', 'Roofing screws', 'pc', 0],
  ['STL', 'Structural steel (as specified)', 'kg', 0], ['BOLT', 'Bolts (as specified)', 'pc', 0]);
LABOR.push(
  ['L_EXC', 'EARTH', 'Labor – excavation', 'm³', 'unit', 0], ['L_BF', 'EARTH', 'Labor – backfill and compaction', 'm³', 'unit', 0],
