      SEC('System'), SEL('sys', 'Ceiling system', [['gyp', 'Gypsum board on metal furring'], ['fc', 'Fiber cement board on metal furring'], ['acoustic', 'Acoustic tiles on T-runner grid'], ['pvc', 'PVC panels on metal furring'], ['wood', 'Plywood on wood frame']], 'gyp'),
      SEL('board', 'Board (gypsum / fiber cement / wood)', [['GYP9', 'Gypsum 9mm'], ['GYP12', 'Gypsum 12mm'], ['MR12', 'Moisture-resistant gypsum 12mm'], ['FC45', 'Fiber cement 4.5mm'], ['FC6', 'Fiber cement 6mm'], ['PLY6', 'Marine plywood 1/4"']], 'GYP9'),
      SEL('fsp', 'Furring / frame spacing', [[0.4, '400 mm'], [0.6, '600 mm']], 0.4), N('waste', 'Waste allowance', '%', 5)],
