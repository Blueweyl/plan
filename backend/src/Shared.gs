    const log = a => (Array.isArray(a) ? a : []).filter(isObj).map(x => Object.fromEntries(Object.entries(x).filter(([k]) => !BAD_KEYS.has(k)).map(([k, v]) => [k, v === null ? null : str(v)])));
    st.revisions.push({no: Number(r.no), id: ID_RE.test(str(r.id)) ? r.id : uid(), createdAt: str(r.createdAt), createdBy: str(r.createdBy), description: str(r.description),
      basedOn: isNum(r.basedOn) ? Number(r.basedOn) : null, status,
      versions: isObj(r.versions) ? Object.fromEntries(Object.entries(r.versions).filter(([k]) => !BAD_KEYS.has(k)).map(([k, v]) => [k, str(v)])) : {},
